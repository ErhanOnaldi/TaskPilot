# Copy to .env for local containers. Do not commit the resulting .env file.
TASKPILOT_POSTGRES_DB=taskpilot
TASKPILOT_POSTGRES_USER=taskpilot
TASKPILOT_POSTGRES_PASSWORD=replace-with-a-local-postgres-password
TASKPILOT_RABBITMQ_USER=taskpilot
TASKPILOT_RABBITMQ_PASSWORD=replace-with-a-local-rabbitmq-password
TASKPILOT_JWT_SECRET=replace-with-at-least-32-random-bytes
# Google OAuth 2.0 Web client id. Leave empty to disable Google sign-in.
TASKPILOT_GOOGLE_CLIENT_ID=
TASKPILOT_POSTGRES_HOST_PORT=5432
TASKPILOT_REDIS_HOST_PORT=6379
TASKPILOT_RABBITMQ_HOST_PORT=5672
TASKPILOT_RABBITMQ_MANAGEMENT_HOST_PORT=15672
TASKPILOT_OLLAMA_HOST_PORT=11434
TASKPILOT_JAEGER_HOST_PORT=16686
TASKPILOT_OTLP_GRPC_HOST_PORT=4317
TASKPILOT_OTLP_HTTP_HOST_PORT=4318
TASKPILOT_API_HOST_PORT=8080
TASKPILOT_OLLAMA_MODEL=llama3.2:3b
TASKPILOT_EMBEDDING_MODEL=nomic-embed-text

# AI chat provider. Tests do not read these values and use deterministic fakes.
# NVIDIA example:
# TASKPILOT_AI_PROVIDER=OpenAI
# TASKPILOT_AI_ENDPOINT=https://integrate.api.nvidia.com/v1
# TASKPILOT_AI_MODEL=deepseek-ai/deepseek-v4-flash
# TASKPILOT_AI_API_KEY=nvapi-...
TASKPILOT_AI_PROVIDER=Ollama
TASKPILOT_AI_ENDPOINT=http://ollama:11434
TASKPILOT_AI_MODEL=llama3.2:3b
TASKPILOT_AI_API_KEY=

TASKPILOT_SEMANTIC_BACKFILL_ENABLED=true
TASKPILOT_MCP_ENABLED=false
TASKPILOT_A2A_ENABLED=false
