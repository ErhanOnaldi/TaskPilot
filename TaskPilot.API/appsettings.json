{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Caching": {
    "Provider": "Redis"
  },
  "Messaging": {
    "Transport": "RabbitMq"
  },
  "Features": {
    "Interop": {
      "McpEnabled": false,
      "A2aEnabled": false
    }
  },
  "Notifications": {
    "DeadlineRemindersEnabled": true,
    "DeadlineReminderWindowHours": 24,
    "DeadlineReminderIntervalMinutes": 15
  },
  "Observability": {
    "SlowRequestThresholdMilliseconds": 300
  }
}
